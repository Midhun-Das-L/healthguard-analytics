# Copy to .env and adjust
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Providers at or above this probability are "flagged" by default
FRAUD_FLAG_THRESHOLD=0.5

# Optional PostgreSQL / MySQL (SQLite is used when these are empty)
# DB_ENGINE=postgresql
# DB_NAME=healthguard
# DB_USERNAME=healthguard
# DB_PASS=secret
# DB_HOST=localhost
# DB_PORT=5432
